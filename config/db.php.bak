<?php
// ============================================================
//  config/db.php  —  Database connection + shared helpers
//  Every PHP file starts with: require_once '../config/db.php';
// ============================================================

// ── Change these when deploying to InfinityFree ─────────────
define('DB_HOST', 'localhost');
define('DB_USER', 'root');
define('DB_PASS', '');
define('DB_NAME', 'classroom_db2');

$conn = new mysqli(DB_HOST, DB_USER, DB_PASS, DB_NAME);

if ($conn->connect_error) {
    die("
    <div style='font-family:sans-serif;padding:40px;text-align:center;
                background:#0f1117;color:#f87171;min-height:100vh;'>
        <h2>⚠ Database Connection Failed</h2>
        <p style='color:#8b95af;margin-top:10px;'>
            Check your credentials in config/db.php
        </p>
        <code style='display:block;margin-top:16px;color:#4a5268;font-size:12px;'>"
        . htmlspecialchars($conn->connect_error) .
        "</code>
    </div>");
}

$conn->set_charset("utf8mb4");
$conn->query("SET time_zone = '+08:00'");   // Philippine Time for every MySQL NOW()/CURRENT_TIMESTAMP
date_default_timezone_set('Asia/Manila');   // same, for any PHP-side date()/time() calls

// ============================================================
//  recalcSubjectGrade($conn, $subject_id, $student_id)
//
//  Called automatically after every score INSERT/DELETE and
//  after every attendance save. Reads the subject's custom
//  weights and recomputes that student's grade for that subject.
//
//  Grade formula:
//    exam_avg     = AVG of all Major Exam scores (%)
//    written_avg  = AVG of all Written Work scores (%)
//    perf_avg     = AVG of all Performance Task scores (%)
//    att_rate     = Present(+Late×0.5) / total days × 100
//
//    Inside the performance component:
//      task_share    = performance_pct - attendance_pct   (e.g. 40-10 = 30)
//      attend_share  = attendance_pct                     (e.g. 10)
//      perf_component = (perf_avg × task_share + att_rate × attend_share)
//                       / performance_pct
//
//    final_grade = (exam_avg    × exam_pct/100)
//               + (written_avg  × written_pct/100)
//               + (perf_component × performance_pct/100)
// ============================================================
function recalcSubjectGrade($conn, $subject_id, $student_id) {

    // 1. Load this subject's weights
    $sub = $conn->prepare(
        "SELECT exam_pct, written_pct, performance_pct, attendance_pct
         FROM subjects WHERE id = ?"
    );
    $sub->bind_param("i", $subject_id);
    $sub->execute();
    $w = $sub->get_result()->fetch_assoc();

    if (!$w) return; // subject not found — do nothing

    $exam_pct        = (float)$w['exam_pct'];
    $written_pct     = (float)$w['written_pct'];
    $performance_pct = (float)$w['performance_pct'];
    $attendance_pct  = (float)$w['attendance_pct'];
    $task_pct        = $performance_pct - $attendance_pct; // e.g. 40-10=30

    // 2. Average of Major Exam scores for this student in this subject
    $q = $conn->prepare(
        "SELECT AVG(score / total_items * 100) AS avg
         FROM score_entries
         WHERE subject_id=? AND student_id=? AND component='Major Exam'"
    );
    $q->bind_param("is", $subject_id, $student_id);
    $q->execute();
    $exam_avg = (float)($q->get_result()->fetch_assoc()['avg'] ?? 0);

    // 3. Average of Written Work scores
    $q2 = $conn->prepare(
        "SELECT AVG(score / total_items * 100) AS avg
         FROM score_entries
         WHERE subject_id=? AND student_id=? AND component='Written Work'"
    );
    $q2->bind_param("is", $subject_id, $student_id);
    $q2->execute();
    $written_avg = (float)($q2->get_result()->fetch_assoc()['avg'] ?? 0);

    // 4. Average of Performance Task scores
    $q3 = $conn->prepare(
        "SELECT AVG(score / total_items * 100) AS avg
         FROM score_entries
         WHERE subject_id=? AND student_id=? AND component='Performance Task'"
    );
    $q3->bind_param("is", $subject_id, $student_id);
    $q3->execute();
    $perf_avg = (float)($q3->get_result()->fetch_assoc()['avg'] ?? 0);

    // 5. Attendance rate for this subject
    $q4 = $conn->prepare(
        "SELECT
            COUNT(*) AS total,
            SUM(CASE WHEN status='Present' THEN 1
                     WHEN status='Late'    THEN 0.5
                     ELSE 0 END)           AS present_count
         FROM attendance
         WHERE subject_id=? AND student_id=?"
    );
    $q4->bind_param("is", $subject_id, $student_id);
    $q4->execute();
    $att = $q4->get_result()->fetch_assoc();
    $att_rate = ($att['total'] > 0)
        ? ((float)$att['present_count'] / (float)$att['total'] * 100)
        : 0;

    // 6. Compute the blended performance component (0-100)
    //    If performance_pct is 0 avoid division by zero
    if ($performance_pct > 0) {
        $perf_component = (($perf_avg * $task_pct) + ($att_rate * $attendance_pct))
                          / $performance_pct;
    } else {
        $perf_component = 0;
    }

    // 7. Final grade (0-100)
    $final = ($exam_avg    * $exam_pct    / 100)
           + ($written_avg * $written_pct / 100)
           + ($perf_component * $performance_pct / 100);

    // 8. Convert to Philippine letter grade
    $letter = letterGrade($final);

    // 9. Upsert into subject_grades
    $u = $conn->prepare(
        "INSERT INTO subject_grades
            (subject_id, student_id,
             exam_avg, written_avg, performance_avg, attendance_rate,
             performance_component, final_grade, letter_grade)
         VALUES (?,?, ?,?,?,?,?,?,?)
         ON DUPLICATE KEY UPDATE
            exam_avg             = VALUES(exam_avg),
            written_avg          = VALUES(written_avg),
            performance_avg      = VALUES(performance_avg),
            attendance_rate      = VALUES(attendance_rate),
            performance_component= VALUES(performance_component),
            final_grade          = VALUES(final_grade),
            letter_grade         = VALUES(letter_grade)"
    );
    $u->bind_param(
        "isdddddds",
        $subject_id, $student_id,
        $exam_avg, $written_avg, $perf_avg, $att_rate,
        $perf_component, $final, $letter
    );
    $u->execute();
}


// ============================================================
//  recalcAllStudentsInSubject($conn, $subject_id)
//  Recalculates every enrolled student's grade for a subject.
//  Useful after changing a subject's weights.
// ============================================================
function recalcAllStudentsInSubject($conn, $subject_id) {
    $res = $conn->prepare(
        "SELECT student_id FROM subject_enrollments WHERE subject_id = ?"
    );
    $res->bind_param("i", $subject_id);
    $res->execute();
    $rows = $res->get_result();
    while ($r = $rows->fetch_assoc()) {
        recalcSubjectGrade($conn, $subject_id, $r['student_id']);
    }
}


// ============================================================
//  letterGrade($grade)
//  Philippine college grading scale (numeric → letter)
// ============================================================
function letterGrade($grade) {
    $grade = (float)$grade;
    if ($grade >= 99) return '1.0';
    if ($grade >= 97) return '1.1';
    if ($grade >= 95) return '1.2';
    if ($grade >= 93) return '1.3';
    if ($grade >= 91) return '1.4';
    if ($grade >= 90) return '1.5';
    if ($grade >= 89) return '1.6';
    if ($grade >= 88) return '1.7';
    if ($grade >= 87) return '1.8';
    if ($grade >= 86) return '1.9';
    if ($grade >= 85) return '2.0';
    if ($grade >= 84) return '2.1';
    if ($grade >= 83) return '2.2';
    if ($grade >= 82) return '2.3';
    if ($grade >= 81) return '2.4';
    if ($grade >= 80) return '2.5';
    if ($grade >= 79) return '2.6';
    if ($grade >= 78) return '2.7';
    if ($grade >= 77) return '2.8';
    if ($grade >= 76) return '2.9';
    if ($grade >= 75) return '3.0';
    return '5.00';
}


// ============================================================
//  getTeacherSubjects($conn, $teacher_id)
//  Returns all active subjects for the logged-in teacher.
//  Used in header.php to build the subject-section dropdown.
// ============================================================
function getTeacherSubjects($conn, $teacher_id) {
    $stmt = $conn->prepare(
        "SELECT id, subject_code, subject_name, section, subject_type,
                school_year, semester,
                exam_pct, written_pct, performance_pct, attendance_pct
         FROM subjects
         WHERE teacher_id = ? AND is_active = 1
         ORDER BY subject_name ASC, section ASC"
    );
    $stmt->bind_param("i", $teacher_id);
    $stmt->execute();
    return $stmt->get_result();
}

// ============================================================
//  teacherOwnsStudent($conn, $teacher_id, $student_id)
//  Returns true if this student is in at least one of this
//  teacher's own sections OR enrolled in at least one of this
//  teacher's subjects. Used to gate edit/delete/reset-password
//  actions in teacher/students.php so a teacher can't touch a
//  student who isn't actually one of theirs. Checks both tables
//  because a student can be on a section roster before any
//  subject has been created for that section yet.
// ============================================================
function teacherOwnsStudent($conn, $teacher_id, $student_id) {
    $stmt = $conn->prepare(
        "SELECT 1 FROM (
            SELECT 1 FROM section_students ss
            JOIN sections sec ON sec.id = ss.section_id
            WHERE ss.student_id = ? AND sec.teacher_id = ?
            UNION ALL
            SELECT 1 FROM subject_enrollments se
            JOIN subjects sub ON sub.id = se.subject_id
            WHERE se.student_id = ? AND sub.teacher_id = ?
         ) t LIMIT 1"
    );
    $stmt->bind_param("sisi", $student_id, $teacher_id, $student_id, $teacher_id);
    $stmt->execute();
    return $stmt->get_result()->num_rows > 0;
}

// ============================================================
//  backfillSubjectEnrollmentsForSection($conn, $section_id, $student_id)
//  When a student is added to a section, make sure they're also
//  enrolled in every subject that section's OWNING teacher has
//  already created for it — otherwise a student added after a
//  subject was created would be on the roster but invisible to
//  that subject's grades/attendance.
//  subjects.section is matched by NAME (there's no section_id
//  column on subjects), so this always also constrains by
//  teacher_id — required now that different teachers can have
//  identically-named sections of their own.
// ============================================================
function backfillSubjectEnrollmentsForSection($conn, $section_id, $student_id) {
    $sec = $conn->prepare("SELECT section_name, teacher_id FROM sections WHERE id = ? LIMIT 1");
    $sec->bind_param("i", $section_id);
    $sec->execute();
    $row = $sec->get_result()->fetch_assoc();
    if (!$row) return 0;

    $subs = $conn->prepare(
        "SELECT id FROM subjects
         WHERE teacher_id = ? AND TRIM(section) = TRIM(?) AND is_active = 1"
    );
    $subs->bind_param("is", $row['teacher_id'], $row['section_name']);
    $subs->execute();
    $subject_ids = array_column($subs->get_result()->fetch_all(MYSQLI_ASSOC), 'id');

    $added = 0;
    foreach ($subject_ids as $subject_id) {
        $e1 = $conn->prepare(
            "INSERT IGNORE INTO subject_enrollments (subject_id, student_id, section_id) VALUES (?, ?, ?)"
        );
        $e1->bind_param("isi", $subject_id, $student_id, $section_id);
        $e1->execute();
        $e2 = $conn->prepare("INSERT IGNORE INTO subject_grades (subject_id, student_id) VALUES (?, ?)");
        $e2->bind_param("is", $subject_id, $student_id);
        $e2->execute();
        $added++;
    }
    return $added;
}

// ============================================================
//  studentHasAnyLinkage($conn, $student_id, $excludeTeacherId = null)
//  Returns true if this student is still tied to any section or
//  subject — optionally ignoring one teacher's own ties. Used when
//  a teacher removes a student from their own classes, to decide
//  whether the student is now fully orphaned (nobody else uses
//  them) and the underlying account can be deleted outright.
// ============================================================
function studentHasAnyLinkage($conn, $student_id, $excludeTeacherId = null) {
    if ($excludeTeacherId !== null) {
        $q = $conn->prepare(
            "SELECT 1 FROM (
                SELECT sec.teacher_id AS tid FROM section_students ss
                JOIN sections sec ON sec.id = ss.section_id
                WHERE ss.student_id = ?
                UNION ALL
                SELECT sub.teacher_id AS tid FROM subject_enrollments se
                JOIN subjects sub ON sub.id = se.subject_id
                WHERE se.student_id = ?
             ) t WHERE t.tid <> ? LIMIT 1"
        );
        $q->bind_param("ssi", $student_id, $student_id, $excludeTeacherId);
    } else {
        $q = $conn->prepare(
            "SELECT 1 FROM (
                SELECT 1 FROM section_students WHERE student_id = ?
                UNION ALL
                SELECT 1 FROM subject_enrollments WHERE student_id = ?
             ) t LIMIT 1"
        );
        $q->bind_param("ss", $student_id, $student_id);
    }
    $q->execute();
    return $q->get_result()->num_rows > 0;
}

// ============================================================
//  subjectTypeBadgeColor($type)
//  Returns a CSS class name for coloring subject type badges.
// ============================================================
function subjectTypeBadgeColor($type) {
    return match($type) {
        'General Education'      => 'badge-blue',
        'Professional Education' => 'badge-red',
        'Major Subject'          => 'badge-green',
        default                  => 'badge-blue',
    };
}


// ============================================================
//  defaultWeights($type)
//  Returns the default weight array for a subject type.
// ============================================================
function defaultWeights($type) {
    return match($type) {
        'General Education'      => ['exam'=>30,'written'=>30,'performance'=>40,'attendance'=>10],
        'Professional Education' => ['exam'=>25,'written'=>25,'performance'=>50,'attendance'=>10],
        'Major Subject'          => ['exam'=>40,'written'=>20,'performance'=>40,'attendance'=>10],
        default                  => ['exam'=>30,'written'=>30,'performance'=>40,'attendance'=>10],
    };
}


// ============================================================
//  createNotification(...)
//  Inserts a single notification for one student.
// ============================================================
function createNotification($conn, $student_id, $type, $title, $message, $link = null, $subject_id = null) {
    $stmt = $conn->prepare(
        "INSERT INTO notifications (student_id, subject_id, type, title, message, link)
         VALUES (?, ?, ?, ?, ?, ?)"
    );
    $stmt->bind_param("sissss", $student_id, $subject_id, $type, $title, $message, $link);
    $stmt->execute();
}

// ============================================================
//  notifyAllEnrolledStudents(...)
//  Sends the same notification to every student currently
//  enrolled in a subject. Used for announcements and for
//  "new output posted" when it should reach everyone.
// ============================================================
function notifyAllEnrolledStudents($conn, $subject_id, $type, $title, $message, $link = null) {
    $stmt = $conn->prepare("SELECT student_id FROM subject_enrollments WHERE subject_id = ?");
    $stmt->bind_param("i", $subject_id);
    $stmt->execute();
    $rows = $stmt->get_result();
    while ($r = $rows->fetch_assoc()) {
        createNotification($conn, $r['student_id'], $type, $title, $message, $link, $subject_id);
    }
}

// ============================================================
//  checkAbsenceStreakNotification($conn, $subject_id, $student_id)
//  Call this right after saving today's attendance for a student.
//  Fires a notification exactly once when their most recent 3
//  attendance records in this subject are all 'Absent' — not
//  again on day 4, 5, 6... of the same streak (checks whether
//  the 4th-most-recent record was ALSO absent; if so, they were
//  already notified at the 3-mark, so skip).
// ============================================================
function checkAbsenceStreakNotification($conn, $subject_id, $student_id) {
    $q = $conn->prepare(
        "SELECT status FROM attendance
         WHERE subject_id=? AND student_id=?
         ORDER BY date DESC, id DESC
         LIMIT 3"
    );
    $q->bind_param("is", $subject_id, $student_id);
    $q->execute();
    $rows = $q->get_result()->fetch_all(MYSQLI_ASSOC);
    if (count($rows) < 3) return;
    foreach ($rows as $r) {
        if ($r['status'] !== 'Absent') return;
    }

    $q2 = $conn->prepare(
        "SELECT status FROM attendance
         WHERE subject_id=? AND student_id=?
         ORDER BY date DESC, id DESC
         LIMIT 1 OFFSET 3"
    );
    $q2->bind_param("is", $subject_id, $student_id);
    $q2->execute();
    $fourth = $q2->get_result()->fetch_assoc();
    if ($fourth && $fourth['status'] === 'Absent') return; // already notified at the 3-mark

    $sn = $conn->prepare("SELECT subject_name FROM subjects WHERE id=?");
    $sn->bind_param("i", $subject_id);
    $sn->execute();
    $subject_name = $sn->get_result()->fetch_assoc()['subject_name'] ?? 'a subject';

    createNotification(
        $conn, $student_id, 'absence_streak',
        "3 consecutive absences",
        "You have been marked absent 3 times in a row in {$subject_name}. Please reach out to your instructor.",
        "/classroomv2/student/subject_detail.php?id={$subject_id}&tab=attendance",
        $subject_id
    );
}

// ============================================================
//  getUnreadNotificationCount($conn, $student_id)
// ============================================================
function getUnreadNotificationCount($conn, $student_id) {
    $q = $conn->prepare("SELECT COUNT(*) AS c FROM notifications WHERE student_id=? AND is_read=0");
    $q->bind_param("s", $student_id);
    $q->execute();
    return (int)($q->get_result()->fetch_assoc()['c'] ?? 0);
}

// ============================================================
//  formatSchedule($days_csv, $start_time, $end_time)
//  Turns "Mon,Wed,Fri" + "09:00:00" + "10:30:00" into a
//  readable "MWF · 9:00 AM–10:30 AM" string. Returns null if
//  any part is missing (subject has no schedule set).
// ============================================================
function formatSchedule($days_csv, $start_time, $end_time) {
    if (empty($days_csv) || empty($start_time) || empty($end_time)) return null;
    $abbrev = ['Mon'=>'M','Tue'=>'T','Wed'=>'W','Thu'=>'Th','Fri'=>'F','Sat'=>'Sa','Sun'=>'Su'];
    $days = array_filter(explode(',', $days_csv));
    $days_str = implode('', array_map(fn($d) => $abbrev[$d] ?? '', $days));
    $start_fmt = date('g:i A', strtotime($start_time));
    $end_fmt   = date('g:i A', strtotime($end_time));
    return "{$days_str} &middot; {$start_fmt}&ndash;{$end_fmt}";
}